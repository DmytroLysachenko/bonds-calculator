{
  "name": "obligacje-calculator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "1.14.5",
      "@opentelemetry/core": "2.10.0",
      "body-parser": "2.3.0",
      "browserslist": "4.28.7",
      "dompurify": "3.4.12",
      "hono": "4.12.32",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "postcss": "8.5.18",
      "protobufjs": "7.6.5",
      "qs": "6.15.3",
      "sharp": "0.35.4"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scan:unused": "tsx scripts/run-unused-scan.ts",
    "analyze:bundles": "tsx scripts/route-bundle-report.ts",
    "analyze:lighthouse": "tsx scripts/lighthouse-summary.ts",
    "check:bundle-budgets": "tsx scripts/check-route-bundle-budgets.ts",
    "test": "vitest",
    "test:browser": "playwright test tests/browser/app-smoke.spec.ts --project=chromium --project=mobile-chromium",
    "test:browser:ci": "playwright test tests/browser/app-smoke.spec.ts tests/browser/home-page.spec.ts tests/browser/education.spec.ts tests/browser/issue-explorer.spec.ts tests/browser/web-vitals.spec.ts tests/browser/audited-workflows.spec.ts tests/browser/preferences.spec.ts --project=chromium --project=mobile-chromium --workers=1",
    "test:browser:matrix": "playwright test tests/browser/app-smoke.spec.ts tests/browser/accessibility.spec.ts --project=firefox --project=webkit --workers=1",
    "test:browser:firefox-csp": "playwright test tests/browser/app-smoke.spec.ts --project=firefox-csp --workers=1 --grep 'single calculator'",
    "test:browser:strict-csp": "playwright test tests/browser/strict-csp-interactions.spec.ts tests/browser/issue-explorer.spec.ts --project=chromium-csp --workers=1",
    "test:browser:visual": "playwright test tests/browser/visual-regression.spec.ts --project=chromium --workers=1",
    "test:browser:integration": "playwright test --config playwright.integration.config.ts",
    "test:home": "playwright test tests/browser/home-page.spec.ts",
    "test:web-vitals": "playwright test tests/browser/web-vitals.spec.ts --project=chromium --project=mobile-chromium --workers=1",
    "test:a11y": "playwright test tests/browser/accessibility.spec.ts --project=chromium --project=mobile-chromium",
    "test:lighthouse": "lhci autorun && tsx scripts/check-lighthouse-route-budgets.ts",
    "test:quality": "pnpm test:a11y && pnpm test:web-vitals && pnpm test:lighthouse",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run db/postgres-migrations.integration.test.ts db/portfolio-repository.integration.test.ts db/rate-limit-store.integration.test.ts --no-file-parallelism",
    "test:core": "vitest run features/bond-core",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:trusted-core": "vitest run features/bond-core/tests/single-bond-edge-golden.test.ts features/bond-core/tests/trusted-core-definition-matrix.test.ts features/bond-core/tests/utils/engine/single-bond-engine.test.ts features/economic-data/tests/lib/economic-dashboard-model.test.ts features/economic-data/tests/economic-data-semantic.test.tsx features/economic-data/tests/economic-chart-failure.test.tsx features/education/tests/education-entry-semantic.test.tsx features/single-calculator/lib/input-guardrails.test.ts features/single-calculator/lib/single-calculator-actions.test.ts features/single-calculator/tests/lib/single-calculator-persistence.test.ts features/single-calculator/tests/lib/single-calculator-restoration.test.ts features/single-calculator/tests/single-result-semantic.test.tsx shared/lib/calculator-persistence.test.ts",
    "test:trusted-core:browser": "playwright test tests/browser/app-smoke.spec.ts --project=chromium --project=mobile-chromium --grep 'trusted-core routes'",
    "test:release": "vitest run features/bond-core i18n/locale-parity.test.ts lib/data/bond-series.test.ts lib/data/macro-market-data.test.ts lib/data/market-data-cache.test.ts lib/page-metadata.test.ts lib/seo/app-json-ld.test.ts lib/sync/sync-engine.test.ts lib/sync/sync-start-year.test.ts shared/lib/data-freshness-display.test.ts shared/lib/regular-investment-display.test.ts shared/lib/bond-display.test.ts shared/lib/feature-catalog.test.ts shared/lib/theme-preferences.test.ts shared/workers/calculation-worker-contract.test.ts app/api/production-readiness-contract.test.ts app/api/operational-endpoints-contract.test.ts app/seo-metadata-contract.test.ts app/provider-boundary-contract.test.ts tests/contracts/ui/interactive-trigger-markup-contract.test.ts tests/contracts/deployment/deployment-contract.test.ts tests/contracts/architecture/clean-code-contract.test.ts tests/contracts/architecture/layer-boundary-contract.test.ts tests/contracts/documentation/documentation-integrity.test.ts scripts/check-production-config.test.ts scripts/verify-production.test.ts scripts/lighthouse-summary.test.ts tests/browser/browser-diagnostics.test.ts package-scripts-contract.test.ts && pnpm test:contracts",
    "check:types": "tsc --noEmit",
    "check:push": "pnpm check:types && pnpm test:core",
    "check:release": "pnpm check:types && pnpm lint && pnpm test:release && pnpm build",
    "check:local-env": "tsx scripts/check-local-env.ts",
    "check:prod-config": "tsx scripts/check-production-config.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "gcp:proxy": "gcloud run services proxy obligacje-calculator --project bond-calculator-pl --region europe-central2 --port 8080",
    "ops:cloud-run-status": "tsx scripts/cloud-run-status.ts",
    "ops:verify-prod": "tsx scripts/verify-production.ts",
    "deploy:prod": "gh workflow run deploy-cloud-run.yml --ref main",
    "db:seed": "tsx db/seed.ts",
    "db:migrate": "drizzle-kit migrate",
    "seed:series": "tsx lib/sync/seed-series-runner.ts",
    "seed:market-history": "tsx lib/sync/seed-market-history.ts",
    "db:seed:production": "tsx lib/sync/seed-production-bonds.ts && tsx lib/sync/seed-production-data.ts",
    "sync:market-history": "tsx lib/sync/sync-market-history.ts",
    "sync:bond-offers": "tsx lib/sync/run-full-sync.ts",
    "sync:full": "tsx lib/sync/run-full-sync.ts",
    "prepare": "husky",
    "test:architecture": "vitest run --config vitest.architecture.config.ts",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "check:test-discovery": "tsx scripts/check-test-discovery.ts"
  },
  "lint-staged": {
    "*": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "get-nonce": "1.0.1",
    "inngest": "^4.21.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.8",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "shadcn": "4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
